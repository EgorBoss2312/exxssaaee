# Скопируйте в .env и подставьте значения. Файл .env подхватывается из каталога backend/.

# --- Языковая модель для чата (RAG уже есть; без LLM ответ = только фрагменты) ---

# Вариант 1: Google Gemini — ключ в https://aistudio.google.com/apikey
# Формат ключа: AIzaSy... или AQ.... Одна строка, без кавычек.
# В РФ прямой доступ часто блокируется (User location is not supported) — см. варианты 2–4.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Опционально: HTTPS-прокси в поддерживаемой стране (EU/US)
# GEMINI_HTTPS_PROXY=http://user:pass@host:port

# Вариант 2: OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Вариант 2б: OpenRouter из РФ (OpenAI-совместимый API, в т.ч. Gemini)
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.5-flash

OPENAI_MODEL=gpt-4o-mini

# Вариант 3: локальная Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Прочее (см. app/config.py) ---
# Render Free / ~512MB RAM: без загрузки PyTorch (псевдо-эмбеддинги, слабее RAG)
# EDDA_USE_HASH_EMBEDDINGS=1
# JWT_SECRET=
# PostgreSQL (psycopg v3). Локально с docker compose: см. DATABASE_URL в docker-compose.yml
# DATABASE_URL=postgresql+psycopg://edda:edda@127.0.0.1:5432/edda
# На деплое (фронт и API на разных доменах или превью-URL):
# CORS_ORIGINS=https://ваш-фронт.example.com
# CORS_ORIGIN_REGEX=https://.*\\.vercel\\.app
