# =====================================================================
# edda-portal — пример конфигурации окружения для docker compose.
# Скопируйте этот файл в `.env` (рядом с docker-compose.yml) и заполните.
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# БД: Supabase (рекомендуемый вариант для прототипа)
# ---------------------------------------------------------------------
# В Supabase Dashboard: Project → Connect → Connection string
#   • Session pooler (рекомендуется): порт 5432, host *.pooler.supabase.com
#   • Direct connection: порт 5432, host *.db.supabase.co
# Подойдёт любой URI вида postgres://... или postgresql://... — приложение
# само нормализует префикс к postgresql+psycopg:// (см. backend/app/config.py).
#
# Пример (вместо <PASSWORD> и <PROJECT_REF> подставьте свои значения):
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Если параметр НЕ задан — docker compose поднимет локальный pg-контейнер `db`
# (запускайте с профилем local-db, см. README ниже в этом файле).
DATABASE_URL=postgresql://postgres.tcxdzhfttlsmdnlolndg:23122004QWERqwer@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# JWT (обязательно задать в проде; локально можно оставить пустым)
# ---------------------------------------------------------------------
# Сгенерировать:  openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------
# CORS (через запятую). По умолчанию допускаются localhost:8000/5173/4173.
# ---------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------
# LLM (опционально). Без ключей RAG отдаёт extractive-ответы.
# ---------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=

# =====================================================================
# Сценарии запуска
# =====================================================================
# 1) Только Supabase (рекомендуется для защиты):
#    заполните DATABASE_URL выше и запустите:
#      docker compose up --build
#    Локальный сервис `db` не поднимется (отключён через profile).
#
# 2) Локальный postgres-контейнер (без Supabase):
#    оставьте DATABASE_URL пустым и запустите с профилем:
#      docker compose --profile local-db up --build
#
# 3) Прод-вариант (полностью контейнерный pg + nginx-ready):
#    docker compose -f docker-compose.prod.yml up -d --build
# =====================================================================
